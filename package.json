{
  "name": "gameguy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-product.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test tests/prepare.test.ts tests/engine.test.ts tests/emulator.test.ts tests/discovery.test.ts tests/process.test.ts tests/product.test.mjs tests/runtime-agent.test.mjs tests/agent-identity.test.mjs tests/model-api.test.mjs tests/model-selection.test.mjs tests/native-host.test.mjs tests/electron-runtime.test.mjs tests/game-dock-ui.test.mjs tests/game-market.test.mjs tests/home-ui.test.mjs tests/brand.test.mjs && python tests/maa-worker.test.py",
    "start": "node scripts/launch-product.mjs",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify:product": "node scripts/verify-product.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:startup": "node scripts/verify-startup.mjs",
    "legacy:setup": "node scripts/setup-profile.mjs",
    "legacy:doctor": "node scripts/doctor.mjs",
    "legacy:smoke": "node scripts/smoke-native.mjs",
    "legacy:verify:runtime": "node scripts/verify-runtime.mjs",
    "legacy:verify:preview": "node scripts/verify-preview.mjs",
    "legacy:verify:native": "node scripts/verify-native.mjs",
    "legacy:start:web": "node scripts/launch-web.mjs",
    "legacy:setup:web": "node scripts/setup-profile.mjs --web",
    "legacy:start": "node scripts/launch.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:discovery": "node scripts/verify-discovery.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:maa-skill": "node scripts/verify-maa-skill.mjs",
    "verify:agent": "node scripts/verify-agent.mjs",
    "verify:session-model": "node scripts/verify-session-model-runtime.mjs && node scripts/verify-session-model-desktop.mjs",
    "verify:native-desktop": "node scripts/verify-native-desktop.mjs",
    "verify:dock-ui": "node scripts/verify-game-dock-ui.mjs",
    "verify:market-ui": "node scripts/verify-game-market-ui.mjs",
    "package:game": "node scripts/package-game.mjs",
    "verify:native-market": "node scripts/verify-native-market.mjs",
    "verify:identity": "node scripts/verify-agent-identity.mjs",
    "verify:home-ui": "node scripts/verify-home-ui.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@gameguy/native-client": "*",
    "@myclaw163/clawclaw-cli": "0.9.1",
    "js-yaml": "4.3.2",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "zod": "4.3.6",
    "@gameguy/agent-extensions": "*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "electron": "39.2.7",
    "esbuild": "0.25.11",
    "pnpm": "11.28.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
